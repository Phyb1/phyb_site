# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE ON DJANGO_SETTINGS_MODULE: python-decouple reads THIS file directly —
# it does not copy values into the real process environment. manage.py,
# wsgi.py, and asgi.py all check os.environ (not .env) before decouple ever
# runs, so setting DJANGO_SETTINGS_MODULE here has no effect on which
# settings module actually loads. Set it as a real environment variable
# instead: `export DJANGO_SETTINGS_MODULE=config.settings.prod` in your
# shell/systemd unit, or in cPanel's "Setup Python App" env vars panel.
# manage.py defaults to config.settings.dev if nothing is set, which is
# what you want for local development anyway.
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres in prod if set; sqlite locally if left blank
DATABASE_URL=

# --- Site / contact -------------------------------------------------------
SITE_NAME=PHYB
SITE_DOMAIN=phyb.co.zw
DEFAULT_FROM_EMAIL=hello@phyb.co.zw

# Shown in nav/footer/WhatsApp buttons — no + or spaces in the number
WHATSAPP_NUMBER=263776298873
CONTACT_PHONE_DISPLAY=+263 77 629 8873
CONTACT_EMAIL=hello@phyb.co.zw
BUSINESS_ADDRESS=Mvurwi, Mashonaland Central, Zimbabwe

# --- Paynow (order processing / Ecocash) -----------------------------------
# Get real values from your Paynow merchant dashboard.
# RESULT_URL must be publicly reachable — Paynow's servers POST to it
# directly, so it won't work against 127.0.0.1 until deployed (or tunneled).
PAYNOW_INTEGRATION_ID=00000
PAYNOW_INTEGRATION_KEY=00000000-0000-0000-0000-000000000000
PAYNOW_RETURN_URL=http://127.0.0.1:8000/orders/payment/return/
PAYNOW_RESULT_URL=http://127.0.0.1:8000/orders/payment/update/

# --- Production only (config/settings/prod.py) ------------------------------
# Ignored locally under config.settings.dev — safe to leave blank in dev.
SECURE_SSL_REDIRECT=True
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
